# ─────────────────────────────────────────────────────────────────────────────
#  VW BOT NATALIA — Variables de entorno
#  Copia este archivo como .env y completa los valores
#  NUNCA subas .env a GitHub
# ─────────────────────────────────────────────────────────────────────────────

# Servidor — NO poner en Railway, la inyecta automáticamente
# PORT=3000
NODE_ENV=production

# Admin
ADMIN_TOKEN=vwbot_natalia_admin_2026

# Redis — en Railway usar ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379

# ── Supabase ───────────────────────────────────────────────────────────────────
SUPABASE_URL=https://febmapoabqpomzvlzght.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...   # anon key del proyecto
SUPABASE_ASESOR=natalia  # nombre del asesor en la tabla precios (natalia o david)

# ── Datos del asesor ───────────────────────────────────────────────────────────
ADVISOR_NAME=Natalia Escobar
ADVISOR_FIRST_NAME=Natalia
ADVISOR_PHONE=573181010022
ADVISOR_CARGO=Asesora Certificada Volkswagen
ADVISOR_CONCESIONARIO=Motorwagen · Cali
ADVISOR_SCHEDULE=L-V 8am–6:30pm | S 8am–3pm
ADVISOR_PORTFOLIO_URL=https://natalia-escobar.vercel.app

# ── Auth WhatsApp ──────────────────────────────────────────────────────────────
# En Railway debe coincidir con el Mount Path del volumen persistente
AUTH_DATA_PATH=/app/auth

# ── Catálogo ───────────────────────────────────────────────────────────────────
# Horas antes de refrescar el catálogo desde Supabase (default: 6)
CATALOG_CACHE_TTL_HOURS=6
